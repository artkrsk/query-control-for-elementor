{
  "name": "@arts/query-control-for-elementor",
  "description": "A set of custom made controls for Elementor to query posts, terms and many more",
  "author": "Artem Semkin",
  "version": "3.2.1",
  "type": "module",
  "license": "MIT",
  "private": true,
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=23.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jquery": "^4.0.1",
    "@types/jqueryui": "^1.12.24",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "4.1.11",
    "cypress": "^15.21.1",
    "swiper": "^14.2.0",
    "depcheck": "^1.4.7",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "npm-check-updates": "^23.1.0",
    "prettier": "^3.9.6",
    "ts-loader": "^9.5.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "@artemsemkin/elementor-types": "file:../elementor-types"
  },
  "scripts": {
    "dev": "node __build__/src/index.js dev",
    "build": "node __build__/src/index.js build",
    "deps:check": "npx npm-check-updates",
    "deps:update": "npx npm-check-updates -u && pnpm install",
    "format": "prettier --write 'src/ts/**/*.{ts,tsx,json,css}'",
    "format:check": "prettier --check 'src/ts/**/*.{ts,tsx,json,css}'",
    "lint": "eslint 'src/ts/**/*.{ts,tsx}'",
    "lint:fix": "eslint --fix 'src/ts/**/*.{ts,tsx}'",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  }
}
