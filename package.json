{
  "name": "@arts/query-control-for-elementor",
  "description": "A set of custom made controls for Elementor to query posts, terms and many more",
  "author": "Artem Semkin",
  "version": "3.3.1",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=23.0.0"
  },
  "devDependencies": {
    "@artemsemkin/elementor-types": "file:../elementor-types",
    "@eslint/js": "^10.0.1",
    "@types/jquery": "^4.0.1",
    "@types/jqueryui": "^1.12.24",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "sass": "^1.108.1",
    "swiper": "^14.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "deps:check": "npx npm-check-updates",
    "deps:update": "npx npm-check-updates -u && pnpm install",
    "format": "prettier --write 'src/ts/**/*.{ts,tsx,json,css}'",
    "format:check": "prettier --check 'src/ts/**/*.{ts,tsx,json,css}'",
    "lint": "eslint 'src/ts/**/*.{ts,tsx}'",
    "lint:fix": "eslint --fix 'src/ts/**/*.{ts,tsx}'",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  }
}
