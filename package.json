{
  "name": "@arts/query-control-for-elementor",
  "description": "A set of custom made controls for Elementor to query posts, terms and many more",
  "author": "Artem Semkin",
  "version": "3.2.1",
  "type": "module",
  "license": "MIT",
  "private": true,
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=23.0.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@>=2.0.0 <3.0.0": "2.1.0",
      "flatted": "3.4.2",
      "js-yaml": ">=4.1.1",
      "lodash": ">=4.18.0",
      "minimatch@>=3.0.0 <4.0.0": "3.1.5",
      "minimatch@>=7.0.0 <8.0.0": "7.4.9",
      "minimatch@>=9.0.0 <10.0.0": "9.0.9",
      "picomatch@>=2.0.0 <3.0.0": "2.3.2",
      "picomatch@>=4.0.0 <5.0.0": "4.0.4",
      "qs": ">=6.14.2",
      "rollup": ">=4.59.0",
      "serialize-javascript": "7.0.5",
      "swiper": ">=12.1.2",
      "systeminformation": ">=5.31.0",
      "undici": "^7.24.0",
      "vite": ">=7.3.2",
      "yaml@>=1.0.0 <2.0.0": "1.10.3"
    }
  },
  "dependencies": {
    "@arts/elementor-types": "file:../elementor-types"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/jquery": "^3.5.33",
    "@types/jqueryui": "^1.12.24",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "4.1.5",
    "cypress": "^15.14.1",
    "swiper": "^12.1.3",
    "depcheck": "^1.4.7",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.5.0",
    "jsdom": "^29.1.0",
    "npm-check-updates": "^22.0.1",
    "prettier": "^3.8.3",
    "ts-loader": "^9.5.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "scripts": {
    "dev": "node __build__/src/index.js dev",
    "build": "node __build__/src/index.js build",
    "deps:check": "npx npm-check-updates",
    "deps:update": "npx npm-check-updates -u && pnpm install",
    "format": "prettier --write 'src/ts/**/*.{ts,tsx,json,css}'",
    "format:check": "prettier --check 'src/ts/**/*.{ts,tsx,json,css}'",
    "lint": "eslint 'src/ts/**/*.{ts,tsx}'",
    "lint:fix": "eslint --fix 'src/ts/**/*.{ts,tsx}'",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  }
}
